{
  "name": "ScrapLogGit2Net (Claude Code, restricted)",
  "build": { "dockerfile": "Dockerfile" },
  "containerUser": "developer",
  "remoteUser": "developer",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/developer/.claude,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/developer/.claude",
    "DEVCONTAINER": "true"
  },
  "runArgs": ["--security-opt=no-new-privileges"],
  "customizations": { "jetbrains": { "backend": "PyCharm" } }
}
